#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/k3s-bootstrap.log) 2>&1

# OS prep (AlmaLinux 9): SSM agent, SELinux policy deps, no host firewall / nm-cloud-setup
dnf install -y "https://s3.${region}.amazonaws.com/amazon-ssm-${region}/latest/linux_amd64/amazon-ssm-agent.rpm"
systemctl enable --now amazon-ssm-agent
dnf install -y container-selinux unzip
systemctl disable --now nm-cloud-setup.service nm-cloud-setup.timer 2>/dev/null || true
systemctl disable --now firewalld 2>/dev/null || true

IMDS_TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION="${k3s_version}" K3S_TOKEN="${k3s_token}" \
  sh -s - server \
    --tls-san "${public_ip}" \
    --node-ip "$PRIVATE_IP" \
    --write-kubeconfig-mode 644

until /usr/local/bin/kubectl get nodes >/dev/null 2>&1; do sleep 5; done

# Publish a kubeconfig pointing at the Elastic IP to SSM Parameter Store
AWSCLI_TMP=$(mktemp -d)
curl -sSfL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o "$AWSCLI_TMP/awscliv2.zip"
unzip -q "$AWSCLI_TMP/awscliv2.zip" -d "$AWSCLI_TMP"
"$AWSCLI_TMP/aws/install"
rm -rf "$AWSCLI_TMP"

KUBECONFIG_OUT=$(mktemp)
sed -e "s/127.0.0.1/${public_ip}/" -e "s/: default$/: ${cluster_name}/" /etc/rancher/k3s/k3s.yaml > "$KUBECONFIG_OUT"
/usr/local/bin/aws ssm put-parameter --region "${region}" \
  --name "/${cluster_name}/kubeconfig" \
  --type SecureString --tier Intelligent-Tiering --overwrite \
  --value "file://$KUBECONFIG_OUT"
rm -f "$KUBECONFIG_OUT"
